(() => {
  'use strict';
  const apiBase='/index.php/apps/cognos';
  const node=(tag,text)=>{const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;};
  const root=()=>document.querySelector('#cognos-activities-page')||document.body;
  async function api(path,options={}){const response=await fetch(apiBase+path,{credentials:'same-origin',headers:{Accept:'application/json',requesttoken:window.OC?.requestToken||''},...options});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.message||`请求失败 ${response.status}`);return data;}
  function layout(){const r=root();r.replaceChildren();r.id='cognos-activities-page';return r;}
  async function render(){const r=layout();const match=location.pathname.match(/\/apps\/cognos\/activities\/([^/]+)/);if(!match){r.append(node('h1','我的 Cognos Activity'));const list=node('section','正在读取…');r.append(list);try{const data=await api('/activities/data');list.replaceChildren();if(!data.activities?.length){list.append(node('p','还没有 Activity。请从 Deck 卡片详情页点击“围绕此任务继续”。'));return;}for(const a of data.activities){const item=node('article');const link=node('a',a.title||'未命名 Activity');link.href=`${apiBase}/activities/${encodeURIComponent(a.id)}`;item.append(link,node('p',new Date(Number(a.created_at)*1000).toLocaleString('zh-CN')));list.append(item);}}catch(e){list.textContent=e.message;}return;}const id=decodeURIComponent(match[1]);r.append(node('a','← 我的 Activity')).href=`${apiBase}/activities`;const heading=node('h1','正在读取 Activity…');r.append(heading);try{const data=await api(`/activities/${encodeURIComponent(id)}/data`);heading.textContent=data.activity.title||'未命名 Activity';const source=node('article');source.append(node('h2','不可变来源快照'));const pre=node('pre',JSON.stringify(data.activity.source_snapshot,null,2));source.append(pre);r.append(source);const runs=node('article');runs.append(node('h2','继续记录'));const list=node('ol');for(const run of data.runs||[])list.append(node('li',`${new Date(Number(run.created_at)*1000).toLocaleString('zh-CN')} · ${run.input_text}`));runs.append(list);const form=document.createElement('form');const input=document.createElement('textarea');input.rows=3;input.required=true;input.placeholder='在这个 Activity 中继续……';const button=node('button','继续');button.type='submit';form.append(input,button);form.addEventListener('submit',async e=>{e.preventDefault();button.disabled=true;try{await api(`/activities/${encodeURIComponent(id)}/continue`,{method:'POST',headers:{'Content-Type':'application/json',requesttoken:window.OC?.requestToken||''},body:JSON.stringify({input:input.value,requestId:crypto.randomUUID()})});await render();}catch(err){runs.append(node('p',err.message));}finally{button.disabled=false;}});runs.append(form);r.append(runs);}catch(e){heading.textContent=e.message;}}
  render();
})();
